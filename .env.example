# TradeSafe — copy to .env and fill in. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
# When STRIPE_SECRET_KEY is set, new trades use Stripe and demo mode stays off.
DEMO_MODE=false
PAYMENT_PROVIDER=stripe

# Supabase (public — also returned by /api/config for the vanilla site)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (optional — authorization holds, NOT licensed escrow)
# Authorization holds, not licensed escrow. Point the Stripe webhook at /api/payments/webhook.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
