# TradeSafe — copy to .env and fill in. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
DEMO_MODE=true
PAYMENT_PROVIDER=demo

# Supabase (public — also returned by /api/config for the vanilla site)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (optional — authorization holds, NOT licensed escrow)
# Set PAYMENT_PROVIDER=stripe and DEMO_MODE=false only after webhook is configured.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
